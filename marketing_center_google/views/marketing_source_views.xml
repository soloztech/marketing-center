<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_marketing_center_source_form_google" model="ir.ui.view">
        <field name="name">marketing.center.source.form.google</field>
        <field name="model">marketing.center.source</field>
        <field
            name="inherit_id"
            ref="marketing_center_base.view_marketing_center_source_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_enqueue_google_catalog_sync"
                    string="Sync Google Ads catalog"
                    type="object"
                    class="oe_highlight"
                    groups="marketing_center_base.group_marketing_center_admin"
                    attrs="{'invisible': ['|', '|', ('service', '!=', 'google.ads'), ('state', '!=', 'active'), ('read_enabled', '=', False)]}"
                />
                <button
                    name="action_enqueue_google_performance_sync"
                    string="Sync Google Ads performance (7 days)"
                    type="object"
                    groups="marketing_center_base.group_marketing_center_admin"
                    attrs="{'invisible': ['|', '|', ('service', '!=', 'google.ads'), ('state', '!=', 'active'), ('read_enabled', '=', False)]}"
                />
                <button
                    name="action_enqueue_google_change_sync"
                    string="Sync Google Ads change history (7 days)"
                    type="object"
                    groups="marketing_center_base.group_marketing_center_admin"
                    attrs="{'invisible': ['|', '|', ('service', '!=', 'google.ads'), ('state', '!=', 'active'), ('read_enabled', '=', False)]}"
                />
                <button
                    name="action_enqueue_google_diagnostic_sync"
                    string="Sync Google Ads diagnostics"
                    type="object"
                    groups="marketing_center_base.group_marketing_center_admin"
                    attrs="{'invisible': ['|', '|', ('service', '!=', 'google.ads'), ('state', '!=', 'active'), ('read_enabled', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
