<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_content_catalog" model="ir.module.category">
        <field name="name">Content Catalog</field>
        <field name="sequence">36</field>
    </record>
    <record id="group_catalog_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="category_id" ref="module_category_content_catalog" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_catalog_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="category_id" ref="module_category_content_catalog" />
        <field name="implied_ids" eval="[(4, ref('group_catalog_reader'))]" />
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_catalog_editor'))]" />
    </record>
    <record id="rule_catalog_subject_company" model="ir.rule">
        <field name="name">Catalog subjects by active company</field>
        <field name="model_id" ref="model_marketing_center_catalog_subject" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_catalog_item_company" model="ir.rule">
        <field name="name">Catalog content by active company</field>
        <field name="model_id" ref="model_marketing_center_catalog_item" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
