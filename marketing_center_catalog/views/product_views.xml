<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_catalog" model="ir.ui.view">
        <field name="name">product.template.form.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_content_catalog"
                    type="object"
                    string="Content"
                    class="oe_stat_button"
                    icon="fa-book"
                    groups="marketing_center_catalog.group_catalog_reader"
                />
            </xpath>
        </field>
    </record>
    <record id="product_variant_form_catalog" model="ir.ui.view">
        <field name="name">product.product.form.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_content_catalog"
                    type="object"
                    string="Content"
                    class="oe_stat_button"
                    icon="fa-book"
                    groups="marketing_center_catalog.group_catalog_reader"
                />
            </xpath>
        </field>
    </record>
</odoo>
