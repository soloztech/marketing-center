<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_google_api_identity_company" model="ir.rule">
        <field name="name">Google API identities by active company</field>
        <field name="model_id" ref="model_google_api_identity" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
