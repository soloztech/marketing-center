<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="measurement_whatsapp_handoff" inherit_id="website.layout" priority="110">
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <t t-nocache="WhatsApp routing is specific to the public request, Website and page.">
                <t t-if="website and not editable">
                    <t t-set="whatsapp_handoff" t-value="website._whatsapp_handoff_config()"/>
                    <div t-if="whatsapp_handoff" id="marketing_whatsapp_handoff_config" hidden="hidden"
                         t-att-data-action="whatsapp_handoff['action']"
                         t-att-data-destination="whatsapp_handoff['destination']"
                         t-att-data-path="whatsapp_handoff['path']"
                         t-att-data-website-id="whatsapp_handoff['website_id']"/>
                </t>
            </t>
        </xpath>
    </template>
    <record id="view_website_handoff_settings" model="ir.ui.view">
        <field name="name">Website WhatsApp default routing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_cookies_bar_setting']" position="after">
                <div class="col-12 o_setting_box" id="website_whatsapp_handoff_setting"
                     groups="marketing_center_base.group_marketing_center_admin">
                    <div class="o_setting_right_pane">
                        <label for="handoff_default_action_id"/>
                        <div class="text-muted">Vincule os botões do WhatsApp em todas as páginas públicas deste site, inclusive páginas novas. Uma regra própria da página tem prioridade.</div>
                        <div class="content-group mt16">
                            <field name="handoff_default_action_id" class="w-100" options="{'no_create': True}"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_action_whatsapp_handoff" model="ir.ui.view">
        <field name="name">marketing.website.action.whatsapp.handoff</field>
        <field name="model">marketing.website.action</field>
        <field name="inherit_id" ref="marketing_center_website.view_marketing_website_action_form"/>
        <field name="arch" type="xml">
            <field name="whatsapp_message" position="after">
                <field name="handoff_enabled"/>
                <field name="handoff_account_id" options="{'no_create': True}" attrs="{'required': [('handoff_enabled', '=', True)]}"/>
                <field name="handoff_reference_prefix" attrs="{'required': [('handoff_enabled', '=', True)]}"/>
            </field>
        </field>
    </record>
    <record id="view_handoff_tree" model="ir.ui.view">
        <field name="name">marketing.website.whatsapp.handoff.tree</field>
        <field name="model">marketing.website.whatsapp.handoff</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="clicked_at"/>
                <field name="reference"/>
                <field name="page_url"/>
                <field name="account_id"/>
            </tree>
        </field>
    </record>
    <record id="view_handoff_form" model="ir.ui.view">
        <field name="name">marketing.website.whatsapp.handoff.form</field>
        <field name="model">marketing.website.whatsapp.handoff</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="clicked_at"/>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="page_url" widget="url"/>
                            <field name="landing_url" widget="url"/>
                            <field name="visitor_id" groups="contact_center_base.group_contact_center_admin"/>
                            <field name="track_id" groups="contact_center_base.group_contact_center_admin"/>
                        </group>
                    </group>
                    <p>O clique registra a saída para o WhatsApp. A associação com a conversa depende da referência recebida ou de confirmação humana de uma sugestão.</p>
                    <field name="match_ids" readonly="1">
                        <tree create="false" edit="false" delete="false">
                            <field name="channel_id"/>
                            <field name="message_at"/>
                            <field name="state"/>
                            <field name="delta_seconds"/>
                            <field name="candidate_count"/>
                        </tree>
                    </field>
                    <group groups="contact_center_base.group_contact_center_admin" string="Aquisição registrada">
                        <field name="acquisition_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_handoffs" model="ir.actions.act_window">
        <field name="name">Cliques do site para WhatsApp</field>
        <field name="res_model">marketing.website.whatsapp.handoff</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>
    <menuitem id="menu_website_whatsapp" name="Site → WhatsApp" parent="marketing_center_base.menu_marketing_center_root" sequence="42" groups="contact_center_base.group_contact_center_agent"/>
    <menuitem id="menu_whatsapp_clicks" name="Cliques" parent="menu_website_whatsapp" action="action_handoffs" sequence="10"/>
</odoo>
