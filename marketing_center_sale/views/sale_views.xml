<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_form_marketing_center" model="ir.ui.view">
        <field name="name">sale.order.form.marketing.center</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_marketing_crm_leads"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-filter"
                    groups="sales_team.group_sale_salesman"
                    attrs="{'invisible': [('marketing_crm_lead_count', '=', 0)]}"
                >
                    <field
                        name="marketing_crm_lead_count"
                        widget="statinfo"
                        string="CRM Leads"
                    />
                </button>
                <button
                    name="action_view_marketing_business_events"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-history"
                    groups="marketing_center_base.group_marketing_center_analyst"
                    attrs="{'invisible': [('marketing_business_event_count', '=', 0)]}"
                >
                    <field
                        name="marketing_business_event_count"
                        widget="statinfo"
                        string="Marketing Events"
                    />
                </button>
                <button
                    name="action_backfill_marketing_events"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    string="Reconcile Marketing"
                    groups="marketing_center_base.group_marketing_center_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
