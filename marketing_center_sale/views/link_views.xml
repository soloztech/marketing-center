<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_crm_lead_form_marketing_sale" model="ir.ui.view">
        <field name="name">crm.lead.form.marketing.sale</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
          name="action_view_marketing_sale_orders"
          type="object"
          class="oe_stat_button"
          icon="fa-shopping-cart"
          groups="sales_team.group_sale_salesman"
          attrs="{'invisible': [('marketing_sale_order_count', '=', 0)]}"
        >
                    <field
            name="marketing_sale_order_count"
            widget="statinfo"
            string="Sales Orders"
          />
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_marketing_business_event_form_sale" model="ir.ui.view">
        <field name="name">marketing.business.event.form.sale</field>
        <field name="model">marketing.business.event</field>
        <field
      name="inherit_id"
      ref="marketing_center_crm.view_marketing_business_event_form_crm"
    />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
          name="action_view_sale_orders"
          type="object"
          class="oe_stat_button"
          icon="fa-shopping-cart"
          groups="sales_team.group_sale_salesman"
          attrs="{'invisible': [('sale_order_count', '=', 0)]}"
        >
                    <field
            name="sale_order_count"
            widget="statinfo"
            string="Sales Orders"
          />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
