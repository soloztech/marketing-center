<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_marketing_contact_center_admin" model="res.groups">
        <field
      name="name"
    >Marketing / Contact Center Bridge Administrator</field>
        <field
      name="category_id"
      ref="marketing_center_base.module_category_marketing_center"
    />
        <field
      name="implied_ids"
      eval="[(4, ref('marketing_center_base.group_marketing_center_admin')), (4, ref('contact_center_base.group_contact_center_admin'))]"
    />
    </record>

    <record id="rule_marketing_contact_center_link_company" model="ir.rule">
        <field
      name="name"
    >Marketing Contact Center links by active company</field>
        <field
      name="model_id"
      ref="model_marketing_attribution_contact_center_link"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
      name="groups"
      eval="[(4, ref('group_marketing_contact_center_admin'))]"
    />
    </record>
</odoo>
