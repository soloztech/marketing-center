    <record
    id="queue_job_channel_marketing_contact_center"
    model="queue.job.channel"
  >
        <field name="name">marketing_contact_center</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>

    <record
    id="queue_job_function_marketing_contact_center_touchpoint_sync"
    model="queue.job.function"
  >
        <field
      name="model_id"
      ref="contact_center_base.model_contact_center_attribution_touchpoint"
    />
        <field name="method">_job_sync_marketing_touchpoint</field>
        <field
      name="channel_id"
      ref="queue_job_channel_marketing_contact_center"
    />
        <field
      name="retry_pattern"
      eval="{1: 10, 2: 30, 3: 60, 4: 120, 5: 300, 6: 600, 7: 1200, 8: 1800, 9: 3600}"
    />
    </record>

