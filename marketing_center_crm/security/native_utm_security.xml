<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="access_native_utm_receipt_salesman" model="ir.model.access">
        <field name="name">Native CRM classification receipts</field>
        <field name="model_id" ref="model_marketing_crm_utm_application" />
        <field name="group_id" ref="sales_team.group_sale_salesman" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_native_utm_receipt_company" model="ir.rule">
        <field name="name">Native CRM classification company scope</field>
        <field name="model_id" ref="model_marketing_crm_utm_application" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_native_utm_receipt_own" model="ir.rule">
        <field name="name">Native CRM classification own leads</field>
        <field name="model_id" ref="model_marketing_crm_utm_application" />
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        <field name="domain_force">[('lead_id', '!=', False), '|', ('lead_id.user_id', '=', user.id), ('lead_id.user_id', '=', False)]</field>
    </record>
    <record id="rule_native_utm_receipt_all" model="ir.rule">
        <field name="name">Native CRM classification all leads</field>
        <field name="model_id" ref="model_marketing_crm_utm_application" />
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
