    <record id="rule_marketing_attribution_crm_link_own" model="ir.rule">
        <field name="name">Marketing attribution CRM links for own leads</field>
        <field name="model_id" ref="model_marketing_attribution_crm_link" />
        <field
      name="groups"
      eval="[(4, ref('sales_team.group_sale_salesman'))]"
    />
        <field
      name="domain_force"
    >[('company_id', 'in', company_ids), ('lead_id', '!=', False), '|', ('lead_id.user_id', '=', user.id), ('lead_id.user_id', '=', False)]</field>
    </record>
