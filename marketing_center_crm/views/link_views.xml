<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
    id="view_marketing_attribution_touchpoint_form_crm"
    model="ir.ui.view"
  >
        <field name="name">marketing.attribution.touchpoint.form.crm</field>
        <field name="model">marketing.attribution.touchpoint</field>
        <field
      name="inherit_id"
      ref="marketing_center_base.view_marketing_attribution_touchpoint_form"
    />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button
            name="action_view_crm_leads"
            type="object"
            class="oe_stat_button"
            icon="fa-filter"
            groups="marketing_center_base.group_marketing_center_admin"
            attrs="{'invisible': [('crm_lead_count', '=', 0)]}"
          >
                        <field
              name="crm_lead_count"
              widget="statinfo"
              string="CRM Leads"
            />
                    </button>
                </div>
            </xpath>
        </field>
    </record>

