<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="queue_channel_native_utm" model="queue.job.channel">
        <field name="name">marketing_native_utm</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>
    <record id="queue_function_native_utm_lead" model="queue.job.function">
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="method">_job_resolve_native_utm</field>
        <field name="channel_id" ref="queue_channel_native_utm" />
        <field name="retry_pattern" eval="{1: 10, 2: 30, 3: 60, 4: 300, 5: 900}" />
    </record>
    <record id="queue_function_native_utm_reconcile" model="queue.job.function">
        <field name="model_id" ref="base.model_res_company" />
        <field name="method">_job_reconcile_native_utm</field>
        <field name="channel_id" ref="queue_channel_native_utm" />
        <field name="retry_pattern" eval="{1: 10, 2: 30, 3: 60, 4: 300, 5: 900}" />
    </record>
</odoo>
