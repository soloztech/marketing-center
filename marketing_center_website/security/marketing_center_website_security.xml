<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="rule_marketing_website_ingress_binding_admin_company" model="ir.rule">
    <field name="name">Website ingress bindings by administrator company</field>
    <field name="model_id" ref="model_marketing_website_ingress_binding" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field
            name="groups"
            eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
        />
  </record>

  <record id="rule_marketing_website_action_admin_company" model="ir.rule">
    <field name="name">Website actions by administrator company</field>
    <field name="model_id" ref="model_marketing_website_action" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field
            name="groups"
            eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
        />
  </record>

  <record id="rule_marketing_website_redirect_grant_admin_company" model="ir.rule">
    <field name="name">Website redirect grants by administrator company</field>
    <field name="model_id" ref="model_marketing_website_redirect_grant" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field
            name="groups"
            eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
        />
  </record>
</odoo>
