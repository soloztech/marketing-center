<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Marketing Website cookie notice settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_cookies_bar_setting']" position="after">
                <div class="col-12 o_setting_box" id="marketing_cookie_notice_setting"
                     attrs="{'invisible': [('website_cookies_bar', '=', False)]}">
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Textos do aviso de cookies</span>
                        <div class="text-muted">Personalize o aviso do site selecionado. Alterar o texto não muda a regra de rastreamento.</div>
                        <div class="content-group mt16">
                            <label for="marketing_cookie_notice_text"/>
                            <field name="marketing_cookie_notice_text" class="w-100"/>
                            <label for="marketing_cookie_test_notice_text"/>
                            <field name="marketing_cookie_test_notice_text" class="w-100"/>
                            <div class="text-muted mb8">O aviso informativo aparece enquanto o modo temporário estiver ativo.</div>
                            <label for="marketing_cookie_proceed_label"/>
                            <field name="marketing_cookie_proceed_label"/>
                            <label for="marketing_cookie_policy_url"/>
                            <field name="marketing_cookie_policy_url" placeholder="/cookie-policy"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
