<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Marketing Website cookie notice settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_cookies_bar_setting']" position="after">
                <div class="col-12 o_setting_box" id="marketing_cookie_notice_setting"
                     attrs="{'invisible': [('website_cookies_bar', '=', False)]}">
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Aviso de cookies</span>
                        <div class="text-muted">Personalize o aviso do site selecionado. Prosseguir fecha o aviso; não registra consentimento.</div>
                        <div class="content-group mt16">
                            <div class="row mb16">
                                <div class="col-12">
                                    <label for="marketing_cookie_notice_text"/>
                                    <field name="marketing_cookie_notice_text" class="w-100"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-lg-4 mb8">
                                    <label for="marketing_cookie_proceed_label"/>
                                    <field name="marketing_cookie_proceed_label" class="w-100"/>
                                </div>
                                <div class="col-12 col-lg-8 mb8">
                                    <label for="marketing_cookie_policy_url"/>
                                    <field name="marketing_cookie_policy_url" class="w-100" placeholder="/cookie-policy"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
