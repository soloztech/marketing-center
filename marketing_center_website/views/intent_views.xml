<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_marketing_website_crm_intent_tree" model="ir.ui.view">
    <field name="name">marketing.website.crm.intent.tree</field>
    <field name="model">marketing.website.crm.intent</field>
    <field name="arch" type="xml">
      <tree create="false" edit="false" delete="false">
        <field name="created_at" />
        <field name="public_ref" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="website_id" />
        <field name="action_id" />
        <field name="lead_id" />
        <field name="lead_display_ref" optional="hide" />
        <field name="state" />
        <field name="retain_until" />
        <field name="proposed_retain_until" optional="show" />
        <field name="privacy_erased_at" optional="show" />
        <field name="attempts" />
        <field name="next_retry_at" />
      </tree>
    </field>
  </record>

  <record id="view_marketing_website_crm_intent_form" model="ir.ui.view">
    <field name="name">marketing.website.crm.intent.form</field>
    <field name="model">marketing.website.crm.intent</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <header>
          <button
                        name="action_apply_retention_policy"
                        string="Apply policy to legacy intent"
                        type="object"
                        attrs="{'invisible': ['|', ('retain_until', '!=', False), ('privacy_erased_at', '!=', False)]}"
                        groups="marketing_center_base.group_marketing_center_admin"
                        confirm="Apply the configured endpoint policy from the original form date? Expired sessions will be erased by retention cleanup. Capture can remain disabled."
                    />
          <button
                        name="action_retry"
                        string="Retry"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'failed')]}"
                        groups="marketing_center_base.group_marketing_center_admin"
                    />
          <button
                        name="action_retry_session"
                        string="Retry session"
                        type="object"
                        attrs="{'invisible': [('session_reconcile_state', '!=', 'failed')]}"
                        groups="marketing_center_base.group_marketing_center_admin"
                    />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="public_ref" />
              <field name="company_id" groups="base.group_multi_company" />
              <field name="website_id" />
              <field name="action_id" />
              <field name="endpoint_id" />
              <field name="lead_id" />
              <field name="lead_model" groups="base.group_system" />
              <field name="lead_res_id" groups="base.group_system" />
              <field name="lead_display_ref" />
            </group>
            <group>
              <field name="created_at" />
              <field name="occurred_at" />
              <field name="processed_at" />
              <field name="attempts" />
              <field name="next_retry_at" />
              <field name="queue_job_uuid" />
              <field name="session_reconcile_state" />
              <field name="session_reconciled_at" />
              <field name="next_session_reconcile_at" />
            </group>
          </group>
          <group string="Failure">
            <field name="last_error_class" />
            <field name="last_error_message" />
          </group>
          <group string="Session identifier retention">
            <field name="retain_until" />
            <field name="proposed_retain_until" />
            <field name="retention_policy_version" />
            <field name="retention_assigned_by" />
            <field name="retention_assigned_at" />
            <field name="privacy_erased_at" />
          </group>
          <group string="Session reconciliation failure">
            <field name="session_reconcile_error_class" />
            <field name="session_reconcile_error_message" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_marketing_website_crm_intents" model="ir.actions.act_window">
    <field name="name">Website CRM Intents</field>
    <field name="res_model">marketing.website.crm.intent</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem
        id="menu_marketing_website_crm_intents"
        name="Website CRM Intents"
        parent="marketing_center_base.menu_marketing_center_configuration"
        action="action_marketing_website_crm_intents"
        sequence="58"
        groups="marketing_center_base.group_marketing_center_admin"
    />
</odoo>
