<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_marketing_web_ingress_endpoint_tree" model="ir.ui.view">
    <field name="name">marketing.web.ingress.endpoint.tree</field>
    <field name="model">marketing.web.ingress.endpoint</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="public_ref" />
        <field name="key_revision" />
        <field name="config_revision" />
        <field name="active" />
      </tree>
    </field>
  </record>

  <record id="view_marketing_web_ingress_endpoint_form" model="ir.ui.view">
    <field name="name">marketing.web.ingress.endpoint.form</field>
    <field name="model">marketing.web.ingress.endpoint</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
                        name="action_rotate_public_key"
                        type="object"
                        string="Rotate public key"
                        class="btn-secondary"
                        confirm="The current browser key will stop working immediately. Continue?"
                    />
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="company_id" groups="base.group_multi_company" />
              <field name="active" />
              <field name="capture_enabled" />
              <field name="public_ref" readonly="1" />
              <field name="public_key" readonly="1" />
            </group>
            <group>
              <field name="key_revision" readonly="1" />
              <field name="config_revision" readonly="1" />
              <field name="replay_window_seconds" />
              <field name="max_body_bytes" />
              <field name="max_field_length" />
              <field name="rate_limit_per_minute" />
            </group>
          </group>
          <group string="Explicit allowlists" col="2">
            <field name="allowed_origins" placeholder="https://www.example.com" />
            <field name="allowed_hosts" placeholder="www.example.com" />
          </group>
          <group string="Optional attribution policy">
            <div class="alert alert-info" colspan="2">
              Capture is blocked until an administrator configures a documented
              non-consent basis and retention. This setting does not record visitor
              consent. Consent-based capture requires a trusted decision integration.
            </div>
            <field name="capture_purpose" />
            <field name="privacy_policy_version" />
            <field name="privacy_notice_version" />
            <field name="privacy_legal_basis_code" />
            <field name="privacy_policy_justification" />
            <field name="identifier_retention_days" />
            <field name="privacy_policy_set_by" />
            <field name="privacy_policy_set_at" />
          </group>
          <group string="Legacy retention assignment">
            <field name="legacy_retention_count" />
            <button name="action_preview_legacy_retention" type="object"
                    string="Review legacy events and proposed deadlines" />
            <button name="action_apply_legacy_retention" type="object"
                    string="Apply policy to next 100 legacy events"
                    confirm="Use the configured duration from each event's original observation date? Expired values will be erased by cleanup. Review proposed deadlines first. Existing deadlines are never extended." />
          </group>
          <notebook>
            <page string="Accepted events">
              <field name="event_ids" readonly="1">
                <tree create="0" edit="0" delete="0">
                  <field name="observed_at" />
                  <field name="origin" />
                  <field name="landing_host" />
                  <field name="state" />
                  <field name="ingress_provenance" />
                  <field name="touchpoint_id" />
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_marketing_web_ingress_endpoints" model="ir.actions.act_window">
    <field name="name">Web Ingress Endpoints</field>
    <field name="res_model">marketing.web.ingress.endpoint</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="view_marketing_web_ingress_event_tree" model="ir.ui.view">
    <field name="name">marketing.web.ingress.event.tree</field>
    <field name="model">marketing.web.ingress.event</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0">
        <field name="observed_at" />
        <field name="endpoint_id" />
        <field name="origin" />
        <field name="landing_host" />
        <field name="state" />
        <field name="ingress_provenance" />
        <field name="touchpoint_id" />
        <field name="retain_until" />
        <field name="proposed_retain_until" optional="show" />
        <field name="erased_at" />
      </tree>
    </field>
  </record>

  <record id="view_marketing_web_ingress_event_form" model="ir.ui.view">
    <field name="name">marketing.web.ingress.event.form</field>
    <field name="model">marketing.web.ingress.event</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group>
              <field name="public_ref" />
              <field name="endpoint_id" />
              <field name="company_id" groups="base.group_multi_company" />
              <field name="state" />
              <field name="ingress_provenance" />
              <field name="touchpoint_id" />
            </group>
            <group>
              <field name="occurred_at" />
              <field name="observed_at" />
              <field name="origin" />
              <field name="landing_host" />
              <field name="body_size_bytes" />
            </group>
          </group>
          <group string="Safe diagnostics">
            <field name="event_key_hash" />
            <field name="request_digest" />
            <field name="key_revision" />
            <field name="config_revision" />
          </group>
          <group string="Retention">
            <field name="retain_until" />
            <field name="proposed_retain_until" />
            <field name="retention_policy_version" />
            <field name="retention_assigned_by" />
            <field name="retention_assigned_at" />
            <field name="erased_at" />
          </group>
          <field name="click_value_ids" readonly="1">
            <tree create="0" edit="0" delete="0">
              <field name="namespace" />
              <field name="value_ref" />
              <field name="comparison_hash" />
              <field name="observed_at" />
            </tree>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_marketing_web_ingress_events" model="ir.actions.act_window">
    <field name="name">Web Ingress Events</field>
    <field name="res_model">marketing.web.ingress.event</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'create': False}</field>
  </record>

  <menuitem
        id="menu_marketing_web_ingress_endpoints"
        name="Web Ingress Endpoints"
        parent="marketing_center_base.menu_marketing_center_configuration"
        action="action_marketing_web_ingress_endpoints"
        sequence="50"
        groups="marketing_center_base.group_marketing_center_admin"
    />
  <menuitem
        id="menu_marketing_web_ingress_events"
        name="Web Ingress Events"
        parent="marketing_center_base.menu_marketing_center_attribution"
        action="action_marketing_web_ingress_events"
        sequence="30"
        groups="marketing_center_base.group_marketing_center_admin"
    />
</odoo>
