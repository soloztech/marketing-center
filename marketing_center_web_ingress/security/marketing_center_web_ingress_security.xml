    <field name="model_id" ref="model_marketing_web_ingress_click_value" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
    />
  </record>

  <record id="rule_marketing_web_ingress_admission_company" model="ir.rule">
    <field name="name">Web ingress admissions by active company</field>
    <field name="model_id" ref="model_marketing_web_ingress_admission" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
    />
  </record>
</odoo>
