<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="automation_new_lead_entry" model="base.automation">
        <field name="name">Marketing: avaliar entrada de novo lead</field>
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="trigger">on_create</field>
        <field name="state">code</field>
        <field name="code">records._cc_queue_automation_entry()</field>
        <field name="filter_domain">[('type', '=', 'lead')]</field>
        <field name="active" eval="True" />
    </record>
    <record id="queue_channel_communication" model="queue.job.channel">
        <field name="name">marketing_communication</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>
    <record id="queue_function_cc_entry" model="queue.job.function">
        <field name="model_id" ref="automation_oca.model_automation_configuration" />
        <field name="method">_job_cc_enroll_lead</field>
        <field name="channel_id" ref="queue_channel_communication" />
    </record>
    <record id="queue_function_cc_step" model="queue.job.function">
        <field name="model_id" ref="automation_oca.model_automation_record_step" />
        <field name="method">_job_cc_execute</field>
        <field name="channel_id" ref="queue_channel_communication" />
    </record>
</odoo>
