<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_meta_webhook_endpoint_company" model="ir.rule">
        <field name="name">Meta webhook endpoints by active company</field>
        <field name="model_id" ref="model_meta_webhook_endpoint" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
