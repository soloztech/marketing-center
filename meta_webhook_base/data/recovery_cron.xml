<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_meta_webhook_recovery" model="ir.cron">
        <field name="name">Meta Webhook: recover orphaned jobs</field>
        <field name="model_id" ref="model_meta_webhook_delivery" />
        <field name="state">code</field>
        <field name="code">model._cron_recover_orphaned_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
    <record id="ir_cron_meta_webhook_subscription_reconcile" model="ir.cron">
        <field name="name">Meta Webhook: reconcile subscriptions</field>
        <field name="model_id" ref="model_meta_webhook_endpoint" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_subscriptions()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
