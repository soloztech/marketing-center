<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <record id="queue_job_channel_meta_webhook" model="queue.job.channel">
        <field name="name">meta_webhook</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>
    <record id="queue_job_function_meta_webhook_delivery" model="queue.job.function">
        <field name="model_id" ref="model_meta_webhook_delivery" />
        <field name="method">_job_fanout</field>
        <field name="channel_id" ref="queue_job_channel_meta_webhook" />
        <field
            name="retry_pattern"
            eval="{1: 5, 2: 15, 3: 30, 4: 60, 5: 120, 6: 300, 7: 600}"
        />
    </record>
    <record id="queue_job_function_meta_webhook_dispatch" model="queue.job.function">
        <field name="model_id" ref="model_meta_webhook_dispatch" />
        <field name="method">_job_process</field>
        <field name="channel_id" ref="queue_job_channel_meta_webhook" />
        <field
            name="retry_pattern"
            eval="{1: 5, 2: 15, 3: 30, 4: 60, 5: 120, 6: 300, 7: 600}"
        />
    </record>
    <record
        id="queue_job_function_meta_webhook_subscription"
        model="queue.job.function"
    >
        <field name="model_id" ref="model_meta_webhook_endpoint" />
        <field name="method">_job_reconcile_subscriptions</field>
        <field name="channel_id" ref="queue_job_channel_meta_webhook" />
        <field
            name="retry_pattern"
            eval="{1: 10, 2: 30, 3: 60, 4: 120, 5: 300, 6: 600, 7: 1200}"
        />
    </record>
</odoo>
