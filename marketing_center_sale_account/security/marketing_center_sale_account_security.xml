<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_marketing_move_sale_link_billing" model="ir.rule">
        <field
      name="name"
    >Marketing invoice sales links for billing users</field>
        <field name="model_id" ref="model_marketing_account_move_sale_link" />
        <field
      name="groups"
      eval="[(4, ref('account.group_account_invoice'))]"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_marketing_move_sale_link_sales_own" model="ir.rule">
        <field name="name">Marketing invoice links for own sales orders</field>
        <field name="model_id" ref="model_marketing_account_move_sale_link" />
        <field
      name="groups"
      eval="[(4, ref('sales_team.group_sale_salesman'))]"
    />
        <field
      name="domain_force"
    >[('company_id', 'in', company_ids), ('order_id', '!=', False), '|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
    </record>
    <record id="rule_marketing_move_sale_link_sales_all" model="ir.rule">
        <field name="name">Marketing invoice links for all sales orders</field>
        <field name="model_id" ref="model_marketing_account_move_sale_link" />
        <field
      name="groups"
      eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_marketing_move_sale_link_analyst" model="ir.rule">
        <field name="name">Marketing invoice sales links for analysts</field>
        <field name="model_id" ref="model_marketing_account_move_sale_link" />
        <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_analyst'))]"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_marketing_move_sale_link_system" model="ir.rule">
        <field
      name="name"
    >Marketing invoice sales links for system administrators</field>
        <field name="model_id" ref="model_marketing_account_move_sale_link" />
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_marketing_sale_account_projection_billing" model="ir.rule">
        <field
      name="name"
    >Marketing sales accounting projections for billing users</field>
        <field name="model_id" ref="model_marketing_sale_account_projection" />
        <field
      name="groups"
      eval="[(4, ref('account.group_account_invoice'))]"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_marketing_sale_account_projection_analyst" model="ir.rule">
        <field
      name="name"
    >Marketing sales accounting projections for analysts</field>
        <field name="model_id" ref="model_marketing_sale_account_projection" />
        <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_analyst'))]"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_marketing_sale_account_projection_system" model="ir.rule">
        <field
      name="name"
    >Marketing sales accounting projections for system administrators</field>
        <field name="model_id" ref="model_marketing_sale_account_projection" />
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
