<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_marketing_dashboard_roster" model="ir.rule">
        <field
      name="name"
    >Marketing dashboard by company and source roster</field>
        <field
      name="model_id"
      ref="model_marketing_center_dashboard_overview"
    />
        <field
      name="domain_force"
    >[('company_id', 'in', company_ids), ('row_kind', '=', 'source'), ('source_id.access_user_ids', 'in', user.id)]</field>
        <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_viewer'))]"
    />
    </record>

    <record id="rule_marketing_dashboard_analyst_summary" model="ir.rule">
        <field
      name="name"
    >Marketing dashboard company summary for analysts</field>
        <field
      name="model_id"
      ref="model_marketing_center_dashboard_overview"
    />
        <field
      name="domain_force"
    >[('company_id', 'in', company_ids), ('row_kind', '=', 'summary')]</field>
        <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_analyst'))]"
    />
    </record>

    <record id="rule_marketing_dashboard_admin_company" model="ir.rule">
        <field name="name">Marketing dashboard by administrator company</field>
        <field
      name="model_id"
      ref="model_marketing_center_dashboard_overview"
    />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
      name="groups"
      eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
    />
    </record>
</odoo>
