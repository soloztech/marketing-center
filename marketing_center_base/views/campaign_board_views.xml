<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_marketing_campaign_board_kanban" model="ir.ui.view">
        <field name="name">marketing.center.external.entity.campaign.kanban</field>
        <field name="model">marketing.center.external.entity</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban
                class="o_marketing_campaign_board"
                create="0"
                edit="0"
                delete="0"
                group_create="0"
                group_delete="0"
                group_edit="0"
                records_draggable="0"
                quick_create="0"
                sample="0"
            >
                <field name="name" />
                <field name="source_id" />
                <field name="source_service" />
                <field name="remote_status" />
                <field name="campaign_platform_label" />
                <field name="campaign_status_label" />
                <field name="campaign_status_group" />
                <field name="campaign_period_label" />
                <field name="campaign_budget_label" />
                <field name="campaign_performance_state" />
                <field name="campaign_performance_note" />
                <field name="campaign_impressions_label" />
                <field name="campaign_clicks_label" />
                <field name="campaign_cost_label" />
                <field name="campaign_group_count" />
                <field name="campaign_ad_count" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            class="oe_kanban_global_click o_kanban_record_has_image_fill"
                        >
                            <div class="oe_kanban_details">
                                <div class="d-flex justify-content-between">
                                    <strong class="o_kanban_record_title"><field
                                            name="name"
                                        /></strong>
                                    <span
                                        t-att-class="'badge ' + ({'active': 'bg-success', 'paused': 'bg-warning text-dark', 'closed': 'bg-secondary'}[record.campaign_status_group.raw_value] || 'bg-light text-dark')"
                                    ><field name="campaign_status_label" /></span>
                                </div>
                                <div class="text-muted small">
                                    <field name="campaign_platform_label" />
                                    <span class="mx-1">·</span>
                                    <field name="source_id" />
                                </div>
                                <div class="mt-2 small">
                                    <div><field name="campaign_period_label" /></div>
                                    <div><field name="campaign_budget_label" /></div>
                                </div>
                                <div
                                    class="mt-2 small o_marketing_campaign_performance"
                                >
                                    <t
                                        t-if="record.campaign_performance_state.raw_value === 'measured'"
                                    >
                                        <div>
                                            <span
                                                class="text-muted"
                                            >Impressions: </span>
                                            <field name="campaign_impressions_label" />
                                        </div>
                                        <div>
                                            <span class="text-muted">Clicks: </span>
                                            <field name="campaign_clicks_label" />
                                        </div>
                                        <div>
                                            <span class="text-muted">Cost: </span>
                                            <field name="campaign_cost_label" />
                                        </div>
                                    </t>
                                    <div
                                        t-else=""
                                        t-att-class="record.campaign_performance_state.raw_value === 'incomplete' ? 'text-warning' : 'text-muted'"
                                    >
                                        <field name="campaign_performance_state" />
                                    </div>
                                    <div
                                        class="text-muted"
                                        t-if="record.campaign_performance_note.raw_value"
                                    ><field name="campaign_performance_note" /></div>
                                    <div
                                        class="text-muted"
                                    >Last 30 days, as reported by the platform.</div>
                                </div>
                                <div class="mt-2 small">
                                    <span
                                        class="text-muted"
                                    >Ad sets or ad groups: </span>
                                    <field name="campaign_group_count" />
                                    <span class="mx-1">·</span>
                                    <span class="text-muted">Ads: </span>
                                    <field name="campaign_ad_count" />
                                </div>
                                <div
                                    class="small text-muted o_marketing_campaign_preview"
                                >Creative preview not synchronized.</div>
                                <div class="o_marketing_campaign_extra" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_marketing_campaign_board_search" model="ir.ui.view">
        <field name="name">marketing.center.external.entity.campaign.search</field>
        <field name="model">marketing.center.external.entity</field>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="source_id" readonly="1" />
                <field name="source_service" />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('remote_status', 'in', ('active', 'enabled'))]"
                />
                <filter
                    name="filter_paused"
                    string="Paused"
                    domain="[('remote_status', 'in', ('paused', 'campaign_paused', 'adset_paused'))]"
                />
                <filter
                    name="filter_closed"
                    string="Closed"
                    domain="[('remote_status', 'in', ('archived', 'deleted', 'removed'))]"
                />
                <separator />
                <filter
                    name="group_platform"
                    string="Platform"
                    context="{'group_by': 'source_service'}"
                />
                <filter
                    name="group_source"
                    string="Account"
                    context="{'group_by': 'source_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_marketing_campaign_board" model="ir.actions.act_window">
        <field name="name">Campaign Board</field>
        <field name="res_model">marketing.center.external.entity</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('entity_type', '=', 'campaign')]</field>
        <field
            name="context"
        >{'search_default_filter_active': 1, 'search_default_group_platform': 1}</field>
        <field name="search_view_id" ref="view_marketing_campaign_board_search" />
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_marketing_campaign_board_kanban')}),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_marketing_external_entity_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_marketing_external_entity_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No synchronized campaign</p>
            <p>
                Campaigns appear here after the daily catalog synchronization of a
                connected advertising account. Nothing is requested from the platforms
                when this board opens.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_marketing_center_campaign_board"
        name="Campaign Board"
        parent="menu_marketing_center_catalog"
        action="action_marketing_campaign_board"
        sequence="1"
        groups="marketing_center_base.group_marketing_center_viewer"
    />
</odoo>
