<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_marketing_metric_daily_tree" model="ir.ui.view">
        <field name="name">marketing.center.metric.daily.tree</field>
        <field name="model">marketing.center.metric.daily</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="report_date" />
                <field name="source_id" />
                <field name="grain" />
                <field name="entity_external_ref" />
                <field name="has_impressions" invisible="1" />
                <field
          name="impressions"
          attrs="{'invisible': [('has_impressions', '=', False)]}"
        />
                <field name="has_clicks" invisible="1" />
                <field
          name="clicks"
          attrs="{'invisible': [('has_clicks', '=', False)]}"
        />
                <field name="has_cost_micros" invisible="1" />
                <field
          name="cost_micros"
          attrs="{'invisible': [('has_cost_micros', '=', False)]}"
        />
                <field name="currency" />
                <field name="last_observed_at" />
                <field name="last_sync_state" />
                <field name="last_sync_finished_at" />
                <field name="current_revision_sequence" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <record id="view_marketing_metric_daily_form" model="ir.ui.view">
        <field name="name">marketing.center.metric.daily.form</field>
        <field name="model">marketing.center.metric.daily</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="report_date" />
                            <field name="company_id" />
                            <field name="source_id" />
                            <field name="grain" />
                            <field name="entity_external_ref" />
                            <field name="entity_id" />
                        </group>
                        <group>
                            <field name="has_impressions" invisible="1" />
                            <field
                name="impressions"
                attrs="{'invisible': [('has_impressions', '=', False)]}"
              />
                            <field name="has_clicks" invisible="1" />
                            <field
                name="clicks"
                attrs="{'invisible': [('has_clicks', '=', False)]}"
              />
                            <field name="has_cost_micros" invisible="1" />
                            <field
                name="cost_micros"
                attrs="{'invisible': [('has_cost_micros', '=', False)]}"
              />
                            <field name="currency" />
                            <field name="last_observed_at" />
                            <field name="last_sync_state" />
                            <field name="last_sync_finished_at" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Revisions">
                            <field name="revision_ids" nolabel="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="revision_sequence" />
                                    <field name="observed_at" />
                                    <field name="has_impressions" invisible="1" />
                                    <field
                    name="impressions"
                    attrs="{'invisible': [('has_impressions', '=', False)]}"
                  />
                                    <field name="has_clicks" invisible="1" />
                                    <field
                    name="clicks"
                    attrs="{'invisible': [('has_clicks', '=', False)]}"
                  />
                                    <field name="has_cost_micros" invisible="1" />
                                    <field
                    name="cost_micros"
                    attrs="{'invisible': [('has_cost_micros', '=', False)]}"
                  />
                                    <field name="content_hash" />
                                </tree>
                            </field>
                        </page>
                        <page
              string="Technical"
              groups="marketing_center_base.group_marketing_center_admin"
            >
                            <group>
                                <field name="public_ref" />
                                <field name="period_start_utc" />
                                <field name="period_end_utc" />
                                <field name="report_timezone" />
                                <field name="metric_origin" />
                                <field name="dimension_hash" />
                                <field name="dimensions_json" />
                                <field name="reporting_context_hash" />
                                <field name="first_observed_at" />
                                <field name="current_content_hash" />
                                <field name="current_revision_id" />
                                <field name="last_sync_run_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketing_metric_daily_search" model="ir.ui.view">
        <field name="name">marketing.center.metric.daily.search</field>
        <field name="model">marketing.center.metric.daily</field>
        <field name="arch" type="xml">
            <search>
                <field name="entity_external_ref" />
                <field name="source_id" />
                <field name="report_date" />
                <filter
          name="group_source"
          string="Source"
          context="{'group_by': 'source_id'}"
        />
                <filter
          name="group_grain"
          string="Grain"
          context="{'group_by': 'grain'}"
        />
                <filter
          name="group_date"
          string="Date"
          context="{'group_by': 'report_date'}"
        />
            </search>
        </field>
    </record>

    <record id="action_marketing_metric_daily" model="ir.actions.act_window">
        <field name="name">Daily Performance</field>
        <field name="res_model">marketing.center.metric.daily</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_marketing_metric_daily_search" />
    </record>
</odoo>
