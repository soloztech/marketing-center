<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_marketing_attribution_asset_resolution" model="ir.cron">
        <field name="name">Marketing: resolve attribution asset references</field>
        <field name="model_id" ref="model_marketing_attribution_asset_resolution" />
        <field name="state">code</field>
        <field
            name="code"
        >model._cron_backfill(limit=200, retry_after_minutes=5)</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
