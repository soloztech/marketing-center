<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_marketing_website_crm_recovery" model="ir.cron">
        <field name="name">Marketing Center: recover Website CRM intents</field>
        <field name="model_id" ref="model_marketing_website_crm_intent" />
        <field name="state">code</field>
        <field name="code">model._cron_enqueue_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_marketing_website_crm_session_reconciliation" model="ir.cron">
        <field name="name">Marketing Center: reconcile Website CRM sessions</field>
        <field name="model_id" ref="model_marketing_website_crm_intent" />
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_sessions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
