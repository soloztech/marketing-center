<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_marketing_website_crm_correlation_company" model="ir.rule">
        <field name="name">Website CRM correlations by active company</field>
        <field name="model_id" ref="model_marketing_website_crm_correlation" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
        />
    </record>
    <record id="rule_marketing_website_crm_intent_company" model="ir.rule">
        <field name="name">Website CRM intents by active company</field>
        <field name="model_id" ref="model_marketing_website_crm_intent" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('marketing_center_base.group_marketing_center_admin'))]"
        />
    </record>
</odoo>
